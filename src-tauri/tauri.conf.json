{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linkora",
  "version": "1.0.0",
  "identifier": "com.hyrican.linkora",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Linkora",
      "width": 1000,
      "height": 700,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "support-kofi",
          "permissions": ["shell:allow-open"],
          "windows": ["main"]
        }
      ]
    }
  },
  "bundle": {
	"resources": ["../src/assets/**"] 
    "active": true,
    "targets": "all", 
    "icon": [
      "icons/icon.ico"
    ]
  }
}